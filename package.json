{
  "name": "react-native-mapsforge-vtm-ext-grib",
  "version": "0.1.0",
  "description": "Weather GRIB overlay extension for react-native-mapsforge-vtm. Renders gridded weather data (wind, temperature, pressure, etc.) as colored overlays on offline vector maps. Android only.",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json",
    "./reanimated": {
      "types": "./lib/typescript/src/reanimated/index.d.ts",
      "default": "./lib/module/reanimated/index.js"
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-mapsforge-vtm-ext-grib-example",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "format": "prettier . --write",
    "clean": "del-cli android/build lib",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "android",
    "maps",
    "offline",
    "weather",
    "grib",
    "mapsforge",
    "vtm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhotadhari/react-native-mapsforge-vtm-ext-grib.git"
  },
  "author": "jhotadhari <tellme@waterproof-webdesign.de> (https://github.com/jhotadhari)",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.22.0",
    "@evilmartians/lefthook": "^2.1.9",
    "@types/react": "^19.2.17",
    "del-cli": "^7.0.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.4",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-multiline-arrays": "^4.1.9",
    "react": "19.2.7",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.43.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-worklets": ">=0.1.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.80.0",
    "react-native-mapsforge-vtm": "*",
    "react-native-reanimated": ">=3.0.0",
    "react-native-worklets": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "codegen",
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNMapsforgeVtmExtGribSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.jhotadhari.reactnative.mapsforge.vtm.ext.grib"
    },
    "includesGeneratedCode": true
  }
}
